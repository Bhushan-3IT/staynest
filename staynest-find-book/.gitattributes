# ============================================
# AUTO DETECT TEXT FILES
# ============================================
* text=auto

# ============================================
# FORCE LF FOR CODE FILES
# ============================================
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# ============================================
# BINARY FILES
# ============================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary

# ============================================
# NODE_MODULES
# ============================================
node_modules/ -text

# ============================================
# ENV FILES
# ============================================
.env* -text